msgstr "unknown"

#: arcamitte/admin.py:1384 arcamitte/templates/arcamitte/dashboard.html:98
msgid "Fecha"
msgstr "Date"

#: arcamitte/admin.py:1393 arcamitte/templates/arcamitte/document_list.html:60
msgid "Caducidad"
msgstr "Expiration"

#: arcamitte/admin.py:1436 arcamitte/templates/arcamitte/analytics.html:935
#: arcamitte/templates/arcamitte/api_tokens.html:54
#: arcamitte/templates/arcamitte/audit_receipt_list.html:54
#: arcamitte/templates/arcamitte/dashboard.html:99
