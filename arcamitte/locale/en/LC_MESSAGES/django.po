msgid "Nivel Departamental"
msgstr "Departmental Level"

#: arcamitte/templates/arcamitte/user_form.html:165
msgid "Habilita la autenticación en el panel interno. Permite operar en las Unidades Organizativas (UOs) donde el usuario esté expresamente asignado."
msgstr "Enables authentication in the internal panel. Allows operation within Organizational Units (OUs) where the user is explicitly assigned."

