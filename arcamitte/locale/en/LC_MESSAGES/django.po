msgid "Acciones"
msgstr "Actions"

#: arcamitte/admin.py:1453
msgid "Plantilla Correo"
msgstr "Email Template"

#: arcamitte/admin.py:1467 arcamitte/templates/arcamitte/dashboard.html:154
msgid "Auditoría"
msgstr "Audit"

#: arcamitte/admin.py:1484
#: arcamitte/templates/admin/arcamitte/terminate_confirmation.html:10
msgid "Finalizar Asiento"
msgstr "Terminate Record"

#: arcamitte/admin.py:1555
msgid "Archivo JSON de aprovisionamiento"
msgstr "Provisioning JSON File"

#: arcamitte/admin.py:1557
msgid ""
"Archivo con extensión .json que contenga las definiciones de "
"'organizational_units' y 'users' según el esquema oficial."
msgstr ""
"JSON file containing definitions for 'organizational_units' and 'users' "
"adhering to the official schema."

#: arcamitte/admin.py:1564
msgid "Debe adjuntar un archivo JSON."
msgstr "You must attach a JSON file."

#: arcamitte/admin.py:1566
msgid "El archivo debe tener extensión .json."
msgstr "File must have a .json extension."

#: arcamitte/admin.py:1599
msgid "Miembros activos"
msgstr "Active members"

#: arcamitte/admin.py:1645
msgid ""
"Solo el Rol Maestro (Superusuario) puede realizar cargas masivas de UOs y "
"Usuarios."
msgstr ""
"Only Master Role (Superusers) can perform bulk imports of OUs and Users."

#: arcamitte/admin.py:1685
msgid "Carga Masiva de Unidades Organizativas y Usuarios (JSON)"
msgstr "Bulk Import of Organizational Units and Users (JSON)"

#: arcamitte/authentication.py:41
msgid "Formato de token de API inválido. Debe comenzar con 'arca_live_'."
msgstr "Invalid API token format. Must start with 'arca_live_'."

#: arcamitte/authentication.py:54
msgid "Error al verificar credenciales."
msgstr "Error verifying credentials."

#: arcamitte/authentication.py:58
msgid "Token de API inválido, revocado o expirado."
msgstr "Invalid, revoked, or expired API token."

#: arcamitte/dashboard_views.py:147
msgid ""
"Esta cuenta de usuario se encuentra temporalmente bloqueada por reiterados "
msgstr "This user account is temporarily locked due to repeated "

#: arcamitte/dashboard_views.py:164
#| msgid ""
#| "Ha superado el límite de solicitudes permitidas. Por favor, espere un "
#| "minuto antes de reintentar."
msgid ""
"Se ha superado el número máximo de intentos de inicio de sesión permitidos. "
"Por seguridad, espere 5 minutos antes de volver a intentarlo."
msgstr "Maximum allowed login attempts exceeded. For security, please wait 5 minutes before trying again."

#: arcamitte/dashboard_views.py:185
msgid ""
"Se ha superado el límite de intentos permitidos para esta cuenta. La cuenta "
"ha sido bloqueada temporalmente por seguridad y se ha remitido un aviso a su "
"buzón de correo."
msgstr "Maximum allowed attempts exceeded for this account. The account has been temporarily locked for security and a notification has been sent to your email."

#: arcamitte/dashboard_views.py:434
msgid "Debe seleccionar un archivo confidencial para cifrar."
msgstr "You must select a confidential file to encrypt."

#: arcamitte/dashboard_views.py:447
msgid "La UO emisora seleccionada no existe."
msgstr "Selected issuing OU does not exist."

#: arcamitte/dashboard_views.py:453
msgid "No tiene autorización operativa sobre la UO emisora seleccionada."
msgstr "You lack operational authorization over the selected issuing OU."

#: arcamitte/dashboard_views.py:473
msgid "Debe especificar al menos una dirección de correo para el canje."
msgstr "You must specify at least one authorized email for redemption."

#: arcamitte/dashboard_views.py:501
msgid "El formato de fecha de caducidad es inválido."
msgstr "Invalid expiration date format."

#: arcamitte/dashboard_views.py:573
#, python-format
msgid ""
"Asiento existente reactivado con éxito. El archivo ha sido re-cifrado, se "
"han actualizado los destinatarios y se ha preservado el registro histórico "
"de auditoría. Hash SHA-256: %(hash)s"
msgstr ""
"Existing entry reactivated successfully. The file has been re-encrypted, "
"recipients have been updated, and historical audit logs have been preserved. "
"SHA-256 Hash: %(hash)s"

#: arcamitte/dashboard_views.py:580
#, python-format
msgid "Asiento cifrado con éxito. Hash SHA-256: %(hash)s"
msgstr "Record successfully encrypted. SHA-256 Hash: %(hash)s"

#: arcamitte/dashboard_views.py:605
msgid "No tiene autorización para inspeccionar este documento."
msgstr "You do not have authorization to inspect this document."

#: arcamitte/dashboard_views.py:826
msgid "Descarga y clausura definitiva de trámite"
msgstr "Download and permanent entry closure"

#: arcamitte/dashboard_views.py:896 arcamitte/dashboard_views.py:928
#| msgid ""
#| "Solo la UO emisora, el autor del asiento personal o un superadministrador "
#| "puede clausurar el documento."
msgid ""
"Solo un Administrador de la UO emisora, el autor del asiento personal o un "
"superadministrador puede clausurar el documento."
msgstr "Only an Administrator of the issuing OU, the author of the personal record, or a superadministrator can close the document."

#: arcamitte/dashboard_views.py:901
msgid "Este documento ya no se encuentra activo."
msgstr "This document is no longer active."

#: arcamitte/dashboard_views.py:937
msgid "Debe proporcionar un motivo justificado para la destrucción anticipada."
msgstr "You must provide a justified reason for early destruction."

#: arcamitte/dashboard_views.py:1061 arcamitte/dashboard_views.py:1077
msgid "Se requieren privilegios administrativos para gestionar API Tokens."
msgstr "Administrative privileges required to manage API Tokens."

#: arcamitte/dashboard_views.py:1084
msgid "Debe proporcionar un nombre o identificador para el servicio."
msgstr "You must provide a name or identifier for the service."

#: arcamitte/dashboard_views.py:1156
msgid "Se requieren privilegios administrativos para revocar API Tokens."
msgstr "Administrative privileges required to revoke API Tokens."

#: arcamitte/dashboard_views.py:1161
msgid "Revocación manual por el operador"
msgstr "Manual revocation by operator"

#: arcamitte/dashboard_views.py:1220
#| msgid "Se requieren privilegios administrativos para gestionar API Tokens."
msgid "Se requieren privilegios administrativos para auditar API Tokens."
msgstr "Administrative privileges required to audit API Tokens."

#: arcamitte/dashboard_views.py:1258 arcamitte/dashboard_views.py:2088
msgid "Unidad Organizativa no encontrada."
msgstr "Organizational Unit not found."

#: arcamitte/dashboard_views.py:1324
#, python-format
msgid "Unidad Organizativa %(alias)s creada exitosamente."
msgstr "Organizational Unit %(alias)s created successfully."

#: arcamitte/dashboard_views.py:1348
msgid "No tiene privilegios para administrar esta Unidad Organizativa."
msgstr "You do not have privileges to manage this Organizational Unit."

#: arcamitte/dashboard_views.py:1374
#, python-format
msgid "Unidad Organizativa %(alias)s actualizada exitosamente."
msgstr "Organizational Unit %(alias)s updated successfully."

#: arcamitte/dashboard_views.py:1399
msgid ""
"No tiene privilegios para administrar miembros en esta Unidad Organizativa."
msgstr ""
"You do not have privileges to manage members in this Organizational Unit."

#: arcamitte/dashboard_views.py:1482
#, python-format
msgid ""
"El usuario %(username)s ya se encuentra asignado a la Unidad Organizativa "
"%(alias)s. Debe ser desvinculado previamente por su UO correspondiente o por "
"un superusuario para quedar libre."
msgstr ""
"User %(username)s is already assigned to Organizational Unit %(alias)s. They "
"must be unlinked beforehand by their respective OU or by a superuser to be "
"released."

#: arcamitte/dashboard_views.py:1503
#, python-format
msgid "Usuario %(username)s asignado a %(alias)s."
msgstr "User %(username)s assigned to %(alias)s."

#: arcamitte/dashboard_views.py:1517
msgid ""
"No tiene privilegios suficientes para modificar el rol de un superusuario "
"del sistema."
msgstr ""
"You do not have sufficient privileges to modify the role of a system "
"superuser."

#: arcamitte/dashboard_views.py:1532
msgid ""
"Por motivos de seguridad operativa, no puede revocar sus propios privilegios "
"de administrador en esta Unidad Organizativa. Esta acción debe ser ejecutada "
"por otro administrador o un superusuario."
msgstr ""
"For operational security reasons, you cannot revoke your own administrator "
"privileges in this Organizational Unit. This action must be performed by "
"another administrator or a superuser."

#: arcamitte/dashboard_views.py:1542
#, python-format
msgid "Rol de %(username)s actualizado a %(role)s."
msgstr "Role for %(username)s updated to %(role)s."

#: arcamitte/dashboard_views.py:1558
msgid ""
"No tiene privilegios suficientes para modificar el estado de un superusuario "
"del sistema."
msgstr ""
"You do not have sufficient privileges to modify the status of a system "
"superuser."

#: arcamitte/dashboard_views.py:1568
msgid ""
"Por motivos de seguridad operativa, no puede desactivar su propia membresía "
"en esta Unidad Organizativa."
msgstr ""
"For operational security reasons, you cannot deactivate your own membership "
"in this Organizational Unit."

#: arcamitte/dashboard_views.py:1575
msgid "activada"
msgstr "activated"

#: arcamitte/dashboard_views.py:1575
msgid "desactivada"
msgstr "deactivated"

#: arcamitte/dashboard_views.py:1578
#, python-format
msgid "Membresía de %(username)s %(state)s."
msgstr "Membership of %(username)s %(state)s."

#: arcamitte/dashboard_views.py:1594
msgid ""
"No tiene privilegios suficientes para desvincular a un superusuario del "
"sistema."
msgstr "You do not have sufficient privileges to unlink a system superuser."

#: arcamitte/dashboard_views.py:1604
msgid ""
"Por motivos de seguridad operativa, no puede auto-expulsarse de esta Unidad "
"Organizativa. Solicite la retirada a otro administrador o a un superusuario."
msgstr ""
"For operational security reasons, you cannot remove yourself from this "
"Organizational Unit. Request removal from another administrator or a "
"superuser."

#: arcamitte/dashboard_views.py:1613
#, python-format
msgid "Usuario %(username)s retirado de %(alias)s."
msgstr "User %(username)s removed from %(alias)s."

#: arcamitte/dashboard_views.py:1644
msgid "No tiene permisos para administrar usuarios ni Unidades Organizativas."
msgstr "You do not have permissions to manage users or Organizational Units."

#: arcamitte/dashboard_views.py:1684 arcamitte/dashboard_views.py:1704
msgid "No tiene permisos para crear usuarios."
msgstr "You do not have permissions to create users."

#: arcamitte/dashboard_views.py:1741
#, python-format
msgid ""
"Usuario %(username)s creado exitosamente. Se ha remitido una contraseña "
"temporal a su correo."
msgstr ""
"User %(username)s created successfully. A temporary password was emailed to "
"their inbox."

#: arcamitte/dashboard_views.py:1749
#, python-format
msgid ""
"Usuario %(username)s creado sin correo electrónico. Deberá asignarle uno "
"para remitirle la contraseña."
msgstr ""
"User %(username)s created without an email address. You must assign one to "
"send credentials."

#: arcamitte/dashboard_views.py:1785
msgid ""
"No tiene privilegios suficientes para administrar a un superusuario del "
"sistema."
msgstr "You do not have sufficient privileges to manage a system superuser."

#: arcamitte/dashboard_views.py:1791
msgid "No tiene permisos para administrar a este usuario."
msgstr "You do not have permissions to manage this user."

#: arcamitte/dashboard_views.py:1825
#, python-format
msgid "Usuario %(username)s actualizado exitosamente."
msgstr "User %(username)s updated successfully."

#: arcamitte/dashboard_views.py:1856
msgid ""
"No tiene privilegios suficientes para resetear la contraseña de un "
"superusuario del sistema."
msgstr ""
"You do not have sufficient privileges to reset the password of a system "
"superuser."

#: arcamitte/dashboard_views.py:1864
msgid "No tiene permisos para resetear la contraseña de este usuario."
msgstr "You do not have permissions to reset this user's password."

#: arcamitte/dashboard_views.py:1909
#| msgid ""
#| "Ha superado el límite de solicitudes permitidas. Por favor, espere un "
#| "minuto antes de reintentar."
msgid ""
"Ha superado el límite de solicitudes de recuperación. Por favor, espere unos "
"minutos antes de reintentar."
msgstr "You have exceeded the recovery request limit. Please wait a few minutes before trying again."

#: arcamitte/dashboard_views.py:1929
msgid ""
"Si la cuenta indicada existe y dispone de un correo configurado, se ha "
"enviado una clave temporal con instrucciones."
msgstr ""
"If the account exists and has a configured email, a temporary password with "
"instructions has been sent."

#: arcamitte/dashboard_views.py:1975
msgid "Su contraseña ha sido actualizada con éxito."
msgstr "Your password has been successfully updated."

#: arcamitte/dashboard_views.py:2033
#| msgid "Nivel de privilegios dentro de esta Unidad Organizativa."
msgid "No dispone de privilegios de analítica en ninguna Unidad Organizativa."
msgstr "You do not have analytics privileges in any Organizational Unit."

#: arcamitte/dashboard_views.py:2104
#| msgid ""
#| "No tiene permisos para administrar usuarios ni Unidades Organizativas."
msgid "No tiene permisos sobre la Unidad Organizativa solicitada."
msgstr "You do not have permissions for the requested Organizational Unit."

