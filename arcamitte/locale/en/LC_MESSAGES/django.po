msgstr "Provisioning JSON File"

#: arcamitte/admin.py:1558
msgid "Archivo con extensión .json que contenga las definiciones de 'organizational_units' y 'users' según el esquema oficial."
msgstr "JSON file containing definitions for 'organizational_units' and 'users' adhering to the official schema."

#: arcamitte/admin.py:1565
msgid "Debe adjuntar un archivo JSON."
msgstr "You must attach a JSON file."

#: arcamitte/admin.py:1567
msgid "El archivo debe tener extensión .json."
msgstr "File must have a .json extension."

#: arcamitte/admin.py:1600
msgid "Miembros activos"
msgstr "Active members"

#: arcamitte/admin.py:1646
msgid "Solo el Rol Maestro (Superusuario) puede realizar cargas masivas de UOs y Usuarios."
msgstr "Only Master Role (Superusers) can perform bulk imports of OUs and Users."

#: arcamitte/admin.py:1686
msgid "Carga Masiva de Unidades Organizativas y Usuarios (JSON)"
msgstr "Bulk Import of Organizational Units and Users (JSON)"

#: arcamitte/authentication.py:41
