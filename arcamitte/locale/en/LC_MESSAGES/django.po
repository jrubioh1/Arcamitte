#: arcamitte/admin.py:509 arcamitte/admin.py:1313 arcamitte/models.py:554
#: arcamitte/models.py:920 arcamitte/templates/arcamitte/dashboard.html:96
#: arcamitte/templates/arcamitte/document_upload.html:49
msgid "UO Emisora"
msgstr "Issuing OU"

#: arcamitte/admin.py:511
msgid "Unidad Organizativa que emite y custodia el documento confidencial."
msgstr ""
"Organizational Unit that issues and custodies the confidential document."

#: arcamitte/admin.py:515 arcamitte/admin.py:631 arcamitte/models.py:563
msgid "UO Receptora (Malla)"
msgstr "Receiving OU (Mesh)"

#: arcamitte/admin.py:519 arcamitte/admin.py:635
msgid ""
"Unidad Organizativa de destino si se trata de un trámite inter-departamental "
"(permite auto-completar buzón y miembros)."
msgstr ""
"Destination Organizational Unit for interdepartmental procedures (allows "
"auto-populating mailbox and members)."

#: arcamitte/admin.py:523
msgid "Archivo confidencial original"
msgstr "Original confidential file"

#: arcamitte/admin.py:526
msgid ""
"Formatos admitidos: PDF, LibreOffice (.odt, .ods, .odp, .odg) o Microsoft "
"Office (.docx, .xlsx, .pptx, .doc, .xls, .ppt)."
msgstr ""
"Supported formats: PDF, LibreOffice (.odt, .ods, .odp, .odg), or Microsoft "
"Office (.docx, .xlsx, .pptx, .doc, .xls, .ppt)."

#: arcamitte/admin.py:530 arcamitte/admin.py:647 arcamitte/models.py:512
msgid "Descripción del documento"
msgstr "Document description"

#: arcamitte/admin.py:537 arcamitte/admin.py:653
msgid "Descripción informativa o motivo confidencial del trámite..."
msgstr "Informative description or confidential reason for the request..."

#: arcamitte/admin.py:541
msgid ""
"Descripción que se incluirá en las notificaciones por correo y en la "
"plantilla corporativa."
msgstr ""
"Description that will be included in email notifications and corporate "
"template."

#: arcamitte/admin.py:545 arcamitte/admin.py:661 arcamitte/models.py:536
msgid "Correos autorizados"
msgstr "Authorized emails"

#: arcamitte/admin.py:547
msgid "Direcciones de correo autorizadas para solicitar el canje con OTP."
msgstr "Authorized email addresses to request OTP redemption."

#: arcamitte/admin.py:550 arcamitte/admin.py:667
msgid "Política de Destrucción"
msgstr "Destruction Policy"

#: arcamitte/admin.py:556
msgid ""
"Seleccione si el archivo en disco debe destruirse de inmediato al primer "
"acceso de cualquiera o conservarse hasta que todos los destinatarios "
"autorizados lo hayan descargado."
msgstr ""
"Select whether the file on disk should be destroyed immediately upon the "
"first access by anyone or kept until all authorized recipients have "
"downloaded it."

#: arcamitte/admin.py:560 arcamitte/admin.py:673 arcamitte/models.py:609
#: arcamitte/models.py:765 arcamitte/models.py:1203
msgid "Fecha de caducidad"
msgstr "Expiration date"

#: arcamitte/admin.py:568
msgid ""
"Fecha y hora límite de validez del asiento (por defecto, 2 semanas desde el "
"registro). Llegada la fecha sin acceso, el asiento se cerrará "
"automáticamente y el archivo se destruirá físicamente en disco."
msgstr ""
"Expiration date and time for the record (defaults to 2 weeks). If unaccessed "
"by this date, the record will automatically close and the physical file will "
"be shredded on disk."

#: arcamitte/admin.py:588
msgid "Debe seleccionar una Unidad Organizativa emisora a la que pertenezca."
msgstr "You must select an issuing Organizational Unit to which you belong."

#: arcamitte/admin.py:596
msgid "No dispone de membresía activa en la Unidad Organizativa seleccionada."
msgstr "You do not have active membership in the selected Organizational Unit."

#: arcamitte/admin.py:603 arcamitte/dashboard_views.py:508
msgid "La fecha de caducidad debe ser posterior a la fecha y hora actual."
msgstr "Expiration date must be in the future."

#: arcamitte/admin.py:612
msgid "Debe seleccionar un archivo."
msgstr "You must select a file."

#: arcamitte/admin.py:639
msgid "Re-subir archivo original (Reactivar)"
msgstr "Re-upload original file (Reactivate)"

#: arcamitte/admin.py:643
msgid ""
"Si el documento ya fue consumido o desea habilitar nuevos destinatarios, "
"suba aquí el archivo original. Se re-cifrará y reactivará manteniendo la "
"trazabilidad histórica."
msgstr ""
"If the document was already consumed or you wish to authorize new "
"recipients, upload the original file here. It will be re-encrypted and "
"reactivated while preserving audit history."

#: arcamitte/admin.py:657
msgid ""
"Descripción que se incluirá en las notificaciones por correo y en la "
"plantilla corporativa. Puede modificarse tanto en documentos activos como "
"reactivados."
msgstr ""
"Description that will be included in email notifications and corporate "
"template. Can be modified for both active and reactivated documents."

#: arcamitte/admin.py:664
msgid "Destinatarios autorizados a solicitar el canje con OTP."
msgstr "Recipients authorized to request redemption with OTP."

#: arcamitte/admin.py:681
msgid ""
"Fecha y hora límite de validez del asiento. Superada la fecha sin acceso, el "
"archivo físico se destruye en disco."
msgstr ""
"Record expiration deadline. After this date without access, the physical "
"file is destroyed on disk."

#: arcamitte/admin.py:849
msgid "Unidades Organizativas (Malla)"
msgstr "Organizational Units (Mesh)"

#: arcamitte/admin.py:853
msgid ""
"Seleccione la UO emisora responsable del documento y, opcionalmente, la UO "
"receptora de destino para el trámite en malla."
msgstr ""
"Select the issuing OU responsible for the document and, optionally, the "
"receiving destination OU for the mesh workflow."

#: arcamitte/admin.py:858
msgid "Registro de Documento"
msgstr "Document Registration"

#: arcamitte/admin.py:862
msgid ""
"Suba el documento original, configure la descripción informativa, los "
"correos autorizados, la política de acceso y la fecha de caducidad del "
"asiento (por defecto 2 semanas)."
msgstr ""
"Upload original document, set informative description, authorized emails, "
"access policy, and expiration deadline (2 weeks by default)."

#: arcamitte/admin.py:869
msgid "Identificación del Documento"
msgstr "Document Identification"

#: arcamitte/admin.py:885
msgid "Ciclo de Vida y Reactivación"
msgstr "Lifecycle and Reactivation"

#: arcamitte/admin.py:900
msgid "Destinatarios Autorizados"
msgstr "Authorized Recipients"

#: arcamitte/admin.py:1071
msgid ""
"Los asientos documentales son inmutables. Utilice la función de finalización "
"de asiento con constancia de vicisitud."
msgstr ""
"Document records are immutable. Use the record termination feature with "
"legal change tracking."

#: arcamitte/admin.py:1076
msgid ""
"Los asientos documentales son inmutables. Utilice la acción masiva de "
"finalización de asientos."
msgstr ""
"Document records are immutable. Use the bulk record termination action."

#: arcamitte/admin.py:1180
msgid ""
"No cuenta con permisos para realizar descargas de auditoría administrativa."
msgstr "You do not have permission to perform administrative audit downloads."

#: arcamitte/admin.py:1184 arcamitte/admin.py:1222
msgid "Documento no encontrado."
msgstr "Document not found."

#: arcamitte/admin.py:1189
msgid ""
"El documento ya fue entregado y no se encuentra disponible en la pasarela."
msgstr ""
"The document has already been delivered and is no longer available on the "
"gateway."

#: arcamitte/admin.py:1229
msgid "No tiene permisos para gestionar este asiento documental."
msgstr "You do not have permission to manage this document record."

#: arcamitte/admin.py:1234
msgid ""
"Este asiento ya se encuentra finalizado y su archivo físico ha sido retirado."
msgstr ""
"This record has already been terminated and its physical file shredded."

#: arcamitte/admin.py:1258
msgid "Finalizar Asiento Documental (Constancia de Vicisitud)"
msgstr "Terminate Document Record (Vicissitude Proof)"

#: arcamitte/admin.py:1264
msgid "⏹️ Finalizar asientos seleccionados (triturar archivo y dejar vicisitud)"
msgstr "⏹️ Terminate selected records (shred physical file and record proof)"

#: arcamitte/admin.py:1295 arcamitte/models.py:853
msgid "Descarga de auditoría administrativa"
msgstr "Administrative audit download"

#: arcamitte/admin.py:1298
msgid "No cuenta con permisos de auditoría."
msgstr "You do not have audit permissions."

#: arcamitte/admin.py:1304
msgid ""
"Por motivos de seguridad, la descarga de auditoría debe realizarse de forma "
"individual por documento."
msgstr ""
"For security reasons, the audit download must be performed individually per "
"document."

#: arcamitte/admin.py:1325 arcamitte/models.py:928
msgid "UO Receptora"
msgstr "Receiving OU"

#: arcamitte/admin.py:1337 arcamitte/models.py:521
#: arcamitte/templates/arcamitte/analytics.html:931
#: arcamitte/templates/arcamitte/dashboard.html:95
#: arcamitte/templates/arcamitte/document_list.html:56
